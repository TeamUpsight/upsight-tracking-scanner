{
  "name": "upsight-tracking-scanner",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node dist/server.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:consent-browser": "vitest run src/scanner/consent/v2-session.production.test.ts src/scanner/audit-runner.production.test.ts",
    "test:regression": "vitest run src/scanner/scanner-core.test.ts",
    "replay": "tsx scripts/replay.ts",
    "benchmark:access": "tsx scripts/access-benchmark.ts",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "playwright-core": "^1.61.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
