# Runtime
NODE_ENV="development"
PORT="3000"

# Optional lightweight authentication. When set, every /api/v1 route requires
# Authorization: Bearer <token> or X-Internal-API-Token: <token>.
INTERNAL_API_TOKEN=""

# Optional build provenance. BUILD_COMMIT is normally supplied by CI (or Git is
# detected during npm run build); BUILD_TIMESTAMP is generated during the build.
BUILD_COMMIT=""

# PostgreSQL. Production fails fast if these values are absent or unreachable.
# For Supabase on an IPv4-only network, set DATABASE_URL to the Session Pooler
# connection string from Dashboard > Connect. Do not use db.<project-ref>.supabase.co
# unless the runtime has IPv6 connectivity (or the project has the IPv4 add-on).
DATABASE_URL=""
DB_HOST=""
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_PORT="5432"
DB_SSL="true"
DB_POOL_MAX="10"

# Memory storage is for explicit local development and tests only.
USE_MEMORY_DB="false"

# Browserless CDP. Third-party external proxies require a Browserless paid
# cloud-unit plan; the scanner fails explicitly rather than silently dropping geo.
BROWSER_PROVIDER="browserless"
BROWSERLESS_HOST="chrome.browserless.io"
BROWSERLESS_TOKEN=""
BROWSERLESS_ROUTE="stealth"
# Keep this above AUDIT_TIMEOUT_MS so Browserless does not terminate a valid scan first.
BROWSERLESS_SESSION_TIMEOUT_MS="120000"
# Manual difficult-site reruns only. Challenge solving is never used for bulk
# scans; keep the bulk control false.
BROWSERLESS_CHALLENGE_SOLVING_ENABLED="true"
BROWSERLESS_CHALLENGE_SOLVING_BULK="false"

# Decodo residential proxies. Supply real credentials; the scanner never
# invents them. Country-endpoint credentials remain opaque while configured
# sticky ports rotate. Backconnect credentials retain valid advanced parameters
# while country/session values rotate.
DECODO_PROXY_USA="http://user:pass@us.decodo.com:10001"
DECODO_PROXY_UK="http://user:pass@uk.decodo.com:10001"
DECODO_PROXY_EU="http://user:pass@eu.decodo.com:10001"
DECODO_PROXY_USA_PORTS="10001,10002,10003"
DECODO_PROXY_UK_PORTS="10001,10002,10003"
DECODO_PROXY_EU_PORTS="10001,10002,10003"
DECODO_PROXY_EU_COUNTRY_FALLBACKS="de,nl,fr,it,es"
# Exactly one fresh Decodo sticky-session retry, with the next configured port.
DECODO_MAX_RETRIES_BULK="1"
DECODO_MAX_RETRIES_SINGLE="1"
# Fresh Browserless Residential /stealth CDP fallback after a confirmed Decodo
# tunnel failure. Bulk scans stop as proxy_error and are candidates instead.
BROWSERLESS_RESIDENTIAL_FALLBACK_ENABLED="true"
BROWSERLESS_RESIDENTIAL_FALLBACK_BULK="false"

# Optional rotating gateway fallback. Disabled unless explicitly enabled.
DECODO_ENABLE_ROTATING_GATEWAY_FALLBACK="false"

# Optional egress verification. Diagnostic mode probes even when this is false.
# Only a salted, truncated IP hash is retained; raw proxy IPs are never stored.
PROXY_EGRESS_PROBE="false"
PROXY_EGRESS_PROBE_URL="https://ip.decodo.com/json"
PROXY_NEUTRAL_PROBE_ENABLED="true"
PROXY_NEUTRAL_PROBE_URL="https://example.com/"
PROXY_IP_HASH_SALT=""
PROXY_PORT_ERROR_THRESHOLD="3"
PROXY_PORT_QUARANTINE_MS="600000"

# Explicitly authorized origin access. The header is attached only to same-site
# top-level GET/HEAD documents for the exact comma-separated domains.
AUTHORIZED_SCAN_DOMAINS=""
AUTHORIZED_SCAN_HEADER_NAME="x-upsight-audit"
AUTHORIZED_SCAN_HEADER_VALUE=""

# Scanner/queue bounds
SCAN_CONCURRENCY="3"
AUDIT_TIMEOUT_MS="90000"
# Bound product discovery and product-consent work below AUDIT_TIMEOUT_MS so a
# slow page cannot consume the entire Browserless session.
PRODUCT_DISCOVERY_BUDGET_MS="15000"
PRODUCT_CONSENT_BUDGET_MS="15000"
MAX_INLINE_RETRY_AFTER_MS="5000"
HOMEPAGE_DOMCONTENT_TIMEOUT_MS="15000"
BULK_DOMAIN_JITTER_MS="2500"
DOMAIN_RATE_LIMIT_COOLDOWN_MS="300000"
DOMAIN_BOT_COOLDOWN_MS="600000"
DOMAIN_ACCESS_COOLDOWN_MS="120000"
MAX_BATCH_SIZE="5000"
MAX_CSV_BYTES="5242880"
STALE_SCAN_MINUTES="10"
